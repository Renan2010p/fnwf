#!/bin/sh
# Five Nights With Friends launcher (C++26 + SDL2).
#    ./fnwf                  -> jogo normal
#    ./fnwf -o (--office)    -> salta direto para o escritório (fast test)
cd "$(dirname "$0")"

for bin in "bin/fnwf-${OSTYPE:-}" bin/fnwf-Linux bin/fnwf-Windows.exe; do
    if [ -f "$bin" ]; then exec "$bin" "$@"; fi
done
if [ -f "build/fnwf" ]; then exec "build/fnwf" "$@"; fi

echo "binary not found — run ./build.sh first" >&2
exit 1
